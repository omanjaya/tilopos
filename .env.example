# Docker Compose environment (read automatically from ./.env by `docker compose`).
#   cp .env.example .env
#
# docker-compose.dev.yml  (npm run docker:dev): only JWT_SECRET is required;
#                         everything else has development defaults.
# docker-compose.yml      (npm run docker:prod): every value marked [prod] is required.
# For running the backend without Docker use packages/backend/.env.example instead.

# --- Required for both stacks ---------------------------------------------------
# >= 32 characters: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Database / Redis / RabbitMQ passwords --------------------------------------
# Dev defaults: tilopos_dev / (none) / tilopass_dev. [prod] set strong values.
POSTGRES_PASSWORD=tilopos_dev
REDIS_PASSWORD=
RABBITMQ_PASSWORD=tilopass_dev

# --- HTTP ------------------------------------------------------------------------
# [prod] Public origin(s) of the web app, comma-separated (never "*")
CORS_ORIGIN=http://localhost:5173
# [prod] Public web URL used in e-mail links
FRONTEND_URL=http://localhost:5173
# Host port for the production web container (nginx on 8080 inside)
WEB_PORT=80
# Host port (bound to 127.0.0.1) for the production backend
PORT=3001
TRUST_PROXY=1
# true exposes GET /api/v1/metrics; set METRICS_TOKEN (>= 16 chars) to require a bearer token
METRICS_ENABLED=false
METRICS_TOKEN=
# >= 32 chars, stable key for encrypting TOTP (MFA) seeds; falls back to one derived from JWT_SECRET
MFA_ENCRYPTION_KEY=

# --- Payments --------------------------------------------------------------------
# Dev: mock. [prod] midtrans | xendit (mock is refused) plus the matching keys.
PAYMENT_GATEWAY=mock
MIDTRANS_SERVER_KEY=
MIDTRANS_ENV=sandbox
XENDIT_API_KEY=
XENDIT_WEBHOOK_TOKEN=

# --- Optional services -----------------------------------------------------------
# Each channel is all-or-nothing (validated at boot): SMTP_HOST needs SMTP_FROM, and
# SMTP_PASS when SMTP_USER is set; WHATSAPP_API_TOKEN needs WHATSAPP_API_URL; the
# three TWILIO_* values go together.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# [prod] local (the uploads volume) | s3 (then S3_BUCKET/REGION/ACCESS_KEY_ID/SECRET_ACCESS_KEY)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
SENTRY_DSN=

# --- Web build arguments (baked into the production web image) -------------------
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=
VITE_CDN_URL=
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_WHATSAPP=

# --- ELK (docker-compose.elk.yml) ------------------------------------------------
ELASTIC_PASSWORD=
KIBANA_PASSWORD=
LOGS_WRITER_PASSWORD=
