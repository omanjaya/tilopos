# TiloPOS backend environment (local development without Docker).
#   cp packages/backend/.env.example packages/backend/.env
# Validated at boot by src/config/env.validation.ts. Keep this file, the root
# .env.example (docker compose), k8s/base/configmap.yaml and
# k8s/base/secrets.yaml.example in sync.
#
# Legend: [required] always, [prod] required when NODE_ENV=production, [optional]

# --- Core ----------------------------------------------------------------------
NODE_ENV=development
PORT=3001
# Business time zone; business-day math uses Asia/Jakarta explicitly as well
TZ=Asia/Jakarta
# [required] Prisma connection string (matches docker-compose.dev.yml defaults)
DATABASE_URL="postgresql://tilopos:tilopos_dev@localhost:5432/tilopos?schema=public"

# --- Auth ----------------------------------------------------------------------
# [required] >= 32 chars (enforced in production): openssl rand -base64 48
JWT_SECRET=dev-only-change-me-0123456789abcdef0123456789
# [required] 3600 | 30m | 12h | 7d (max 7d)
JWT_EXPIRES_IN=7d
# Absolute lifetime of a rotating refresh-token family (maximum 30d).
REFRESH_TOKEN_EXPIRES_IN=7d
# [optional] >= 32 chars, stable key for AES-GCM encryption of TOTP (MFA) seeds.
# Falls back to a key derived from JWT_SECRET (rotating JWT_SECRET then breaks MFA).
MFA_ENCRYPTION_KEY=
# [optional] Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- HTTP ----------------------------------------------------------------------
# [prod] Comma-separated origins; "*" is rejected
CORS_ORIGIN=http://localhost:5173
# [prod] Public web URL used in e-mail links
FRONTEND_URL=http://localhost:5173
# [optional] Express "trust proxy" setting when running behind a reverse proxy /
# ingress: false | true | <hop count, e.g. 1> | comma-separated subnets.
# Leave empty when clients connect directly.
TRUST_PROXY=
# [optional] Expose Prometheus metrics at GET /api/v1/metrics (true|false; ENABLE_METRICS is an alias)
METRICS_ENABLED=false
# [optional] Bearer token (>= 16 chars) required by /api/v1/metrics when set
METRICS_TOKEN=

# --- Redis (queues, distributed cron locks, cache) -----------------------------
# [prod] REDIS_HOST. Use maxmemory-policy noeviction on the server.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- RabbitMQ (optional; falls back to the in-process RxJS event bus) ----------
# Matches docker-compose.dev.yml defaults
RABBITMQ_URL=amqp://tilo:tilopass_dev@localhost:5672
RABBITMQ_EXCHANGE=tilo.events
RABBITMQ_QUEUE_PREFIX=tilo
RABBITMQ_RETRY_ATTEMPTS=3
RABBITMQ_RETRY_DELAY=5000

# --- Payments ------------------------------------------------------------------
# mock | midtrans | xendit. "mock" is refused when NODE_ENV=production.
PAYMENT_GATEWAY=mock
PAYMENT_GATEWAY_URL=
# [prod, midtrans] MIDTRANS_SERVER_KEY and MIDTRANS_ENV=production
MIDTRANS_SERVER_KEY=
MIDTRANS_ENV=sandbox
# [prod, xendit] XENDIT_API_KEY and XENDIT_WEBHOOK_TOKEN
XENDIT_API_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_WEBHOOK_URL=
QRIS_API_URL=
# Shared secret for inbound integration webhooks
WEBHOOK_SECRET=

# --- Notifications -------------------------------------------------------------
# Every channel is optional but all-or-nothing (validated at boot); an unconfigured
# channel reports NOT_CONFIGURED instead of pretending to send.
# E-mail: SMTP_HOST requires SMTP_FROM, and SMTP_PASS (alias SMTP_PASSWORD) when SMTP_USER is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# WhatsApp: WHATSAPP_API_TOKEN requires WHATSAPP_API_URL (e.g. https://api.fonnte.com/send)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
# SMS (Twilio): all three or none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Push (Firebase Cloud Messaging) - not implemented; push notifications report NOT_CONFIGURED
FCM_SERVER_KEY=

# --- Storage -------------------------------------------------------------------
# [prod] local | s3. Without it, development uses S3 when S3_ACCESS_KEY_ID is set, else
# ./uploads. "local" in production needs a volume shared by every instance (RWX PVC).
STORAGE_DRIVER=local
# [STORAGE_DRIVER=s3] S3_BUCKET, S3_REGION, S3_ACCESS_KEY_ID (alias S3_ACCESS_KEY),
# S3_SECRET_ACCESS_KEY (alias S3_SECRET_KEY)
S3_BUCKET=tilopos-uploads
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only for S3-compatible storage (MinIO, R2, Spaces)
S3_ENDPOINT=
CDN_URL=

# --- Observability -------------------------------------------------------------
SENTRY_DSN=
SERVICE_NAME=tilo-backend
LOG_LEVEL=info
# Optional direct log shipping to Elasticsearch (see docker-compose.elk.yml)
ELASTICSEARCH_URL=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
# [prod, when ELASTICSEARCH_URL is set] API key or USERNAME+PASSWORD
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX_PREFIX=tilo-logs

# --- Backups (scripts/backup-db.sh) ----------------------------------------------
# Dedicated bucket for database backups (not S3_BUCKET) and the GPG recipient to encrypt to
BACKUP_S3_BUCKET=
BACKUP_GPG_RECIPIENT=

# --- Seeding (development only) ------------------------------------------------
# The demo seed TRUNCATES every table. It refuses to run in production and
# unless ALLOW_DESTRUCTIVE_SEED=true. `prisma migrate reset` runs the seed too,
# so it also needs this flag (ALLOW_DESTRUCTIVE_SEED=true npx prisma migrate reset).
ALLOW_DESTRUCTIVE_SEED=false
# PIN for every seeded demo login (4-8 digits, default 1234)
SEED_DEFAULT_PIN=1234
# seed-udsayan.ts: initial PIN for imported employees (random 6-digit PIN printed once if empty)
SEED_INITIAL_PIN=
# seed-udsayan.ts: directory with the customer spreadsheets (keep outside the repo)
UDSAYAN_DIR=
