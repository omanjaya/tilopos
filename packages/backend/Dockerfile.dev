# Development image for docker-compose.dev.yml (build context: repository root).
FROM node:22.23.3-alpine3.24

RUN apk add --no-cache openssl tzdata
ENV HUSKY=0 \
    TZ=Asia/Jakarta

WORKDIR /repo
COPY package.json package-lock.json ./
COPY packages/backend/package.json packages/backend/
COPY packages/web/package.json packages/web/
# Root `prepare` (husky) is a git-hook installer; not needed in images.
RUN npm pkg delete scripts.prepare && npm ci --workspace=@tilo/backend --include-workspace-root=false

COPY packages/backend/prisma packages/backend/prisma
WORKDIR /repo/packages/backend
RUN npx prisma generate

EXPOSE 3001 9229

# Single dev container: applying pending migrations on start is safe here.
CMD ["sh", "-c", "npx prisma migrate deploy && npm run dev"]
