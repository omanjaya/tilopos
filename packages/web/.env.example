# API Base URL (optional, defaults to /api/v1 for production proxy)
# For local development without Docker:
# VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_API_BASE_URL=/api/v1

# WebSocket origin for realtime (Socket.IO). Optional; defaults to VITE_API_URL,
# then the current page origin.
# VITE_WS_URL=http://localhost:3001
# VITE_API_URL=http://localhost:3001

# Support contacts shown in the header menu and Help Center. Leave empty to hide them.
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_WHATSAPP=

# Build-time CDN base URL for static assets (vite.config.ts). Optional.
# VITE_CDN_URL=https://cdn.example.com/
