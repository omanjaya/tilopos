# TEMPLATE ONLY - never commit real values and never add this file to kustomization.yaml.
#
# The manifests expect two Secrets in the target namespace:
#   tilopos-secrets  - backend + redis (keys below)
#   tilopos-backup   - backup CronJob (dedicated backup bucket credentials)
#
# Preferred: External Secrets Operator / Sealed Secrets (see external-secret.example.yaml).
# Quick manual alternative:
#   kubectl -n tilopos-production create secret generic tilopos-secrets --from-env-file=tilopos-secrets.env
#
# Key names must match packages/backend/src/config/env.validation.ts and
# packages/backend/.env.example. Non-secret settings live in configmap.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: tilopos-secrets
type: Opaque
stringData:
  # Prisma connection string (managed Postgres). Add sslmode=require for remote DBs.
  DATABASE_URL: "postgresql://tilopos:CHANGE_ME@postgres.example.internal:5432/tilopos?schema=public&sslmode=require"

  # >= 32 random chars: openssl rand -base64 48
  JWT_SECRET: "CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG"

  # Shared by the Redis StatefulSet (--requirepass) and the backend
  REDIS_PASSWORD: "CHANGE_ME"

  # Bearer token Prometheus uses for GET /api/v1/metrics (>= 16 chars)
  METRICS_TOKEN: "CHANGE_ME_AT_LEAST_16_CHARS"

  # >= 32 chars, stable key encrypting MFA (TOTP) seeds; never rotate without re-enrolling MFA
  MFA_ENCRYPTION_KEY: "CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG"

  # Payment gateway (PAYMENT_GATEWAY in configmap.yaml selects which ones are required)
  XENDIT_API_KEY: ""
  XENDIT_WEBHOOK_TOKEN: ""
  MIDTRANS_SERVER_KEY: ""

  # SMTP credentials (host/port/from in configmap.yaml)
  SMTP_USER: ""
  SMTP_PASS: ""

  # Uploads object storage; required when STORAGE_DRIVER=s3 (configmap.yaml), unused with "local".
  S3_ACCESS_KEY_ID: ""
  S3_SECRET_ACCESS_KEY: ""

  # Optional integrations. Channels are all-or-nothing (validated at boot):
  # WHATSAPP_API_TOKEN needs WHATSAPP_API_URL (configmap.yaml); TWILIO_* go together.
  SENTRY_DSN: ""
  WHATSAPP_API_TOKEN: ""
  GOOGLE_CLIENT_ID: ""
  GOOGLE_CLIENT_SECRET: ""
  TWILIO_ACCOUNT_SID: ""
  TWILIO_AUTH_TOKEN: ""
  TWILIO_FROM_NUMBER: ""
  FCM_SERVER_KEY: ""
  WEBHOOK_SECRET: ""
  ELASTICSEARCH_USERNAME: ""
  ELASTICSEARCH_PASSWORD: ""
  ELASTICSEARCH_API_KEY: ""
---
apiVersion: v1
kind: Secret
metadata:
  name: tilopos-backup
type: Opaque
stringData:
  # A bucket used ONLY for backups (not S3_BUCKET). Enable versioning + lifecycle retention.
  BACKUP_S3_BUCKET: "tilopos-backups"
  AWS_DEFAULT_REGION: "ap-southeast-1"
  # Write-only (PutObject) credentials for the backup bucket
  AWS_ACCESS_KEY_ID: "CHANGE_ME"
  AWS_SECRET_ACCESS_KEY: "CHANGE_ME"
  # Only for S3-compatible storage (MinIO, R2, Spaces); remove for AWS
  BACKUP_S3_ENDPOINT: ""
